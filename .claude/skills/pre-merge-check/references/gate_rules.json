{
  "_source": ".github/workflows/ci.yml、.gitignore、專案規格 §9，以及 log.md 既有 checkpoint 格式",
  "_note": "調整門檻只改這個檔案，不要改 scripts/check_merge.py。pattern 以 / 結尾代表整個目錄，否則用 glob。",
  "base_branch": "main",
  "max_file_bytes": 5242880,
  "ignore": [
    "reports/merge_check/"
  ],
  "forbidden": [
    {
      "pattern": ".env",
      "reason": "機密檔，.gitignore 明列；只有 .env.example 可進版控"
    },
    {
      "pattern": "**/.env",
      "reason": "機密檔，.gitignore 明列"
    },
    {
      "pattern": "*.key",
      "reason": "金鑰檔，.gitignore 明列"
    },
    {
      "pattern": "*.pem",
      "reason": "私鑰／憑證檔"
    },
    {
      "pattern": "*.pfx",
      "reason": "私鑰／憑證檔"
    },
    {
      "pattern": "data/",
      "reason": "資料產物依規格 §9 不進版控（raw／interim／processed 皆是）"
    },
    {
      "pattern": "*.db",
      "reason": "執行期 SQLite 資料庫不進版控"
    },
    {
      "pattern": "*.sqlite",
      "reason": "執行期 SQLite 資料庫不進版控"
    },
    {
      "pattern": "*.sqlite3",
      "reason": "執行期 SQLite 資料庫不進版控"
    },
    {
      "pattern": "logs/",
      "reason": ".gitignore 明列"
    },
    {
      "pattern": ".powerquery-public/",
      "reason": "執行期工作區，.gitignore 明列"
    },
    {
      "pattern": ".powerquery-data/",
      "reason": "執行期資料工作區"
    },
    {
      "pattern": ".powerquery-learning/",
      "reason": "學習工作區"
    },
    {
      "pattern": "架構參考/",
      "reason": "課程教材含未去識別化真實電號，.gitignore 明列"
    },
    {
      "pattern": "files/",
      "reason": "原始快照由 GitHub Releases 保存，不重複提交"
    },
    {
      "pattern": "manifest.csv",
      "reason": "原始快照 manifest 由 Releases 保存"
    },
    {
      "pattern": "manifest.json",
      "reason": "原始快照 manifest 由 Releases 保存"
    },
    {
      "pattern": "releases/**/*.zip",
      "reason": "release 壓縮包由 GitHub Releases 保存"
    },
    {
      "pattern": "__pycache__/",
      "reason": "Python 快取"
    },
    {
      "pattern": "**/__pycache__/**",
      "reason": "Python 快取"
    },
    {
      "pattern": "*.pyc",
      "reason": "Python 快取"
    },
    {
      "pattern": ".venv/",
      "reason": "虛擬環境不進版控"
    },
    {
      "pattern": ".ruff_cache/",
      "reason": "工具快取"
    },
    {
      "pattern": ".pytest_cache/",
      "reason": "工具快取"
    }
  ],
  "secret_patterns": [
    {
      "name": "OpenAI API key",
      "regex": "sk-[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "AWS access key id",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "name": "GitHub token",
      "regex": "gh[pousr]_[A-Za-z0-9]{30,}"
    },
    {
      "name": "private key block",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "name": "硬編碼 api key／secret／token",
      "regex": "(?i)(api[_-]?key|secret|token|passwd|password) *[:=] *[\"'][^\"' ]{12,}[\"']"
    }
  ],
  "_secret_allowlist_note": "已知且刻意進版控的值。確認過才加，每一條都要寫 reason；也可以在該行加註解 pre-merge-check: allow-secret 單點排除。",
  "secret_allowlist": [
    {
      "regex": "PowerQuery@123",
      "reason": "loopback-only 公開展示預設密碼，log.md CP-013 與 docs/SERVING.md 明載，刻意進版控；遠端登入一律拒絕"
    }
  ],
  "conventional_commit_types": [
    "feat",
    "fix",
    "docs",
    "style",
    "refactor",
    "perf",
    "test",
    "build",
    "ci",
    "chore",
    "revert"
  ],
  "doc_sync": [
    {
      "when": [
        "src/serving/app.py",
        "src/serving/runtime.py",
        "src/serving/data_management.py",
        "src/serving/admin_auth.py"
      ],
      "expect_any": [
        "src/serving/API_CONTRACT.md",
        "docs/SERVING.md",
        "README.md"
      ],
      "reason": "HTTP 行為或 runtime 有變更時，API 契約／啟動文件必須同步（TEAM_4_ROLES 合併檢查表）"
    },
    {
      "when": [
        "configs/"
      ],
      "expect_any": [
        "README.md",
        "docs/",
        ".env.example"
      ],
      "reason": "設定項變更需要同步說明文件，避免其他 Owner 不知道新旗標"
    }
  ]
}
