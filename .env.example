# 本檔僅供環境變數設定參考；PowerQuery 不會自動載入此檔。

# 選用：啟用 OpenAI 長尾查詢。API key 不應提交至 Git。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 管理員帳密必須同時設定。若兩行都未設定，loopback 展示環境會使用
# 公開預設 admin / PowerQuery@123；正式或對外環境務必取消註解並換成自己的值。
# POWERQUERY_ADMIN_USERNAME=your-admin-name
# POWERQUERY_ADMIN_PASSWORD=replace-with-a-long-random-password

# 管理 session 絕對有效期：300～3600 秒。
POWERQUERY_ADMIN_SESSION_TTL_SECONDS=900

# 允許承載管理介面的 hostname/IP，不含 port；逗號分隔。
POWERQUERY_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# 未登入者的查詢範圍：all（預設，公開展示可直接試玩）或 denied（查詢一律需要登入）。
# 這個選擇要明講，不該是隱含預設：它決定「沒有帳號的人看得到什麼」。
POWERQUERY_ANONYMOUS_QUERY_SCOPE=all

# 四眼原則：預設提案人不可核准自己的資料變更，需要第二個帳號審核。
# 單人部署可設為 true 放行，但每一筆自審都會在變更紀錄與稽核鏈標上 self_approved，
# 事後仍查得出哪些發布沒有經過第二個人。
# POWERQUERY_ALLOW_SELF_APPROVAL=false
